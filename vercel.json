{
  "redirects": [
    {
      "source": "/empresa-dashboard.html",
      "destination": "/gestor-dashboard.html",
      "permanent": false
    },
    {
      "source": "/empresa-dashboard",
      "destination": "/gestor-dashboard.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "X-XSS-Protection", "value": "1; mode=block"}
      ]
    }
  ]
}
